# Runtime logs written by the app (storage/ also has its own .gitignore).
storage/*.log

# Landlord-uploaded listing photos. These are user data, not source code:
# they are recreated per install and would otherwise bloat the repository.
assets/uploads/boarding_houses/
!assets/uploads/.htaccess

# Background photos an administrator uploads in Appearance. Same reasoning.
assets/uploads/site/

# Composer, if and when it is added.
/vendor/
composer.lock

# Editor and OS noise.
.vscode/
.idea/
*.swp
*~
Thumbs.db
Desktop.ini
.DS_Store

# Local environment overrides. Database credentials belong in the
# ROOMEASE_DB_* environment variables, never in a tracked file.
.env
.env.local

# Google sign-in credentials. Copy config/google.local.example.php to create it.
config/google.local.php

# Gmail App Password for outgoing email. Copy config/mail.local.example.php to create it.
config/mail.local.php
