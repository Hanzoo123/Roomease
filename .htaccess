# RoomEase web server rules. Browsers only need the pages and /assets;
# everything else here is read by PHP only.

Options -Indexes

# --- Directories that must never be fetched over HTTP ---------------------
<IfModule mod_alias.c>
  RedirectMatch 404 (?i)^/(?:.*/)?(config|database|includes|storage)/
  RedirectMatch 404 (?i)^/(?:.*/)?\.git(/|$)
  # Block copies of the app inside this folder (old code, same database).
  RedirectMatch 404 (?i)^/(?:.*/)?roomease/roomease/
  # Same for .claude/ (Claude Code's working copies).
  RedirectMatch 404 (?i)^/(?:.*/)?\.claude(/|$)
</IfModule>

# Block Composer's vendor/ (assets/vendor/ is not affected).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^vendor(/|$) - [NC,R=404,L]

  # Old links to about/contact/terms/privacy go to their new place in legal/.
  # %1 is the app's folder, so this works in a subfolder too.
  RewriteCond %{REQUEST_URI} ^(.*/)?(about|contact|terms|privacy)\.php$
  RewriteRule ^(about|contact|terms|privacy)\.php$ %1legal/$1.php [R=301,L]

  # Unknown pages show our own 404.php (missing assets keep Apache's short 404).
  RewriteCond %{REQUEST_URI} !(^|/)assets/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . 404.php [L]
</IfModule>

# --- File types that are never meant to be downloaded ---------------------
# Office files here are project documents, not part of the site.
<FilesMatch "(?i)\.(sql|log|md|ini|json|lock|bak|old|sample|dist|yml|yaml|doc|docx|xls|xlsx|ppt|pptx|odt|ods|odp)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<FilesMatch "(?i)^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# --- Headers, as a backstop for anything Apache serves without PHP --------
# PHP pages set these themselves; this covers static files. setifempty
# avoids sending them twice.
<IfModule mod_headers.c>
  Header setifempty X-Content-Type-Options "nosniff"
  Header setifempty X-Frame-Options "SAMEORIGIN"
  Header setifempty Referrer-Policy "strict-origin-when-cross-origin"
  Header always unset X-Powered-By
</IfModule>

<IfModule mod_php.c>
  php_flag display_errors off
  php_flag log_errors on
</IfModule>
<IfModule mod_php7.c>
  php_flag display_errors off
  php_flag log_errors on
</IfModule>
