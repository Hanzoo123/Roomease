# Copy this file to .env and fill in your own values. .env is git-ignored.
ROOMEASE_DB_HOST=localhost
ROOMEASE_DB_NAME=roomease
ROOMEASE_DB_USER=root
ROOMEASE_DB_PASS=

# Development only. When a password reset email cannot be sent, show the code
# on screen to someone browsing from this computer. Never turn this on where
# other people can reach the site, including through ngrok or a tunnel.
ROOMEASE_SHOW_RESET_CODES=false
