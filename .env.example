# Copy this file to .env and fill in your own values. .env is git-ignored.
ROOMEASE_DB_HOST=localhost
# Leave empty for 3306. On WAMP, if phpMyAdmin shows the roomease database
# under "MariaDB" rather than "MySQL", it is usually on 3307.
ROOMEASE_DB_PORT=
ROOMEASE_DB_NAME=roomease
ROOMEASE_DB_USER=root
ROOMEASE_DB_PASS=

# Development only. When a password reset email cannot be sent, show the code
# on screen to someone browsing from this computer. Never turn this on where
# other people can reach the site, including through ngrok or a tunnel.
ROOMEASE_SHOW_RESET_CODES=false

# The Gmail address reset codes are sent from, and a 16-letter App Password
# for it (not the account's own password). Without these, no email is sent.
# config/mail.local.php still works instead, and .env wins if both are set.
#ROOMEASE_MAIL_USERNAME=you@gmail.com
#ROOMEASE_MAIL_PASSWORD=abcdefghijklmnop

# Gmail's port. 465 is the default and talks TLS at once; use 587 on a network
# that blocks it, which connects first and starts TLS with STARTTLS.
#ROOMEASE_MAIL_PORT=465

# Where the contact page sends messages. Without it that page still explains
# how to reach the team, but the form is not offered.
#ROOMEASE_CONTACT_EMAIL=hello@example.com

# The team's Facebook page and Messenger link, listed on the contact page.
# Each row appears only when its address is set.
#ROOMEASE_FACEBOOK_URL=https://www.facebook.com/yourpage
#ROOMEASE_MESSENGER_URL=https://m.me/yourpage

# "Continue with Google", from an OAuth client ID of type Web application.
# config/google.local.php still works instead, and .env wins if both are set.
#ROOMEASE_GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
#ROOMEASE_GOOGLE_CLIENT_SECRET=your-client-secret
