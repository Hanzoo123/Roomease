# Uploaded files: serve them, never run them. The upload code already
# blocks .php files; this is a second lock in case one gets through.

Options -Indexes -ExecCGI

# Turn PHP off in this folder.
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php5.c>
  php_flag engine off
</IfModule>

# For PHP-FPM/CGI servers, where the lines above don't apply.
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .pht .phar
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .pht .phar

<FilesMatch "(?i)\.(php|phtml|php[0-9]|phps|pht|phar|cgi|pl|py|sh|asp|aspx|jsp|htaccess)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Never let a browser treat an upload as a web page.
<IfModule mod_headers.c>
  Header setifempty X-Content-Type-Options "nosniff"
  Header set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'"
  Header set Content-Disposition "inline"
</IfModule>
